# Local synthetic demo only. Copy to .env for overrides; tracked defaults match this file.
# Never expose these development credentials publicly or use them in production.
RESOLVEAI_ENV=demo
DATABASE_URL=postgresql+psycopg://resolveai_demo:resolveai_local_demo@127.0.0.1:55432/resolveai_demo
API_DATABASE_URL=postgresql+psycopg://resolveai_api:resolveai_api_local@127.0.0.1:55432/resolveai_demo
SIMULATOR_DATABASE_URL=postgresql+psycopg://resolveai_simulator:resolveai_simulator_local@127.0.0.1:55432/resolveai_demo
ORACLE_DATABASE_URL=postgresql+psycopg://resolveai_oracle:resolveai_oracle_local@127.0.0.1:55432/resolveai_demo
RESOLVEAI_API_DB_PASSWORD=resolveai_api_local
RESOLVEAI_SIMULATOR_DB_PASSWORD=resolveai_simulator_local
RESOLVEAI_ORACLE_DB_PASSWORD=resolveai_oracle_local
SIMULATOR_BASE_URL=http://127.0.0.1:8001
SIMULATOR_TOKEN=resolveai_simulator_local_token
SIMULATOR_ALLOW_FAULTS=0
WEB_ORIGIN=http://127.0.0.1:5173
MODEL_PROVIDER=fake
MODEL_NAME=
MODEL_API_KEY=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
LLM_BUDGET_USD=0
# The default API stays fake. A separate owner process may set RESOLVEAI_ALLOW_LIVE=1,
# MODEL_PROVIDER=openai, MODEL_NAME=gpt-6-luna, and a positive LLM_BUDGET_USD.
# OPENAI_API_KEY belongs only in the untracked .env. The default API ignores it.
RUN_MAX_MODEL_CALLS=12
RUN_MAX_TOOL_CALLS=20
RUN_MAX_REPLANS=2
RUN_MAX_READ_RETRIES=2
